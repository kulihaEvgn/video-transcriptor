#!/usr/bin/env bash
# vidnotes — транскрипт видео + скриншоты ключевых мест (Claude выбирает моменты)
# usage: vidnotes video.mp4 [lang] [count]
set -euo pipefail

V="${1:?usage: vidnotes <video> [lang=auto] [count=12]}"
LANG_="${2:-auto}"
COUNT="${3:-12}"
MODEL="${WHISPER_MODEL:-$HOME/.cache/whisper-cpp/ggml-large-v3-turbo-q5_0.bin}"

[ -f "$V" ] || { echo "нет файла: $V" >&2; exit 1; }
[ -f "$MODEL" ] || { echo "нет модели: $MODEL" >&2; exit 1; }
ffprobe -v error -select_streams v:0 -show_entries stream=codec_type "$V" >/dev/null || { echo "не видео: $V" >&2; exit 1; }

OUT="${V%.*}_notes"
mkdir -p "$OUT/shots"

echo "[1/4] аудио…"
ffmpeg -nostdin -v error -y -i "$V" -vn -ar 16000 -ac 1 -c:a pcm_s16le "$OUT/audio.wav"

echo "[2/4] транскрипт…"
whisper-cli -m "$MODEL" -l "$LANG_" -f "$OUT/audio.wav" -osrt -otxt -of "$OUT/transcript" 2>"$OUT/whisper.log"
[ -s "$OUT/transcript.srt" ] || { echo "whisper не выдал транскрипт" >&2; exit 1; }

echo "[3/4] Claude выбирает моменты…"
claude -p --output-format json "Below is an SRT transcript of a video. Pick the $COUNT most important moments — where something is decided, shown, demonstrated, or the topic shifts. Spread them across the whole video, not just the start.
Output ONLY lines in the exact format:
HH:MM:SS | short caption in the transcript's own language
No preamble, no numbering, no other text." < "$OUT/transcript.srt" > "$OUT/claude.json" || true
jq -r '.result // ""' "$OUT/claude.json" 2>/dev/null \
  | grep -oE '^[0-9]{2}:[0-9]{2}:[0-9]{2}([.,][0-9]{1,3})? \| .+' | head -n "$COUNT" > "$OUT/moments.txt" || true
jq -r '"      \(.usage.input_tokens + .usage.cache_creation_input_tokens + .usage.cache_read_input_tokens) токенов на вход (\(.usage.cache_read_input_tokens) из кэша), \(.usage.output_tokens) на выход, $\(.total_cost_usd)"' "$OUT/claude.json" 2>/dev/null || true
[ -s "$OUT/moments.txt" ] || { echo "Claude не вернул таймкоды — смотри $OUT/claude.json и $OUT/transcript.srt" >&2; exit 1; }

echo "[4/4] скриншоты…"
{
  echo "# $(basename "$V")"
  echo
  i=0
  while IFS='|' read -r ts caption; do
    ts="${ts// /}"; ts="${ts//,/.}"; caption="${caption# }"
    i=$((i+1)); n=$(printf '%02d' "$i")
    shot="${n}_${ts%%.*}"; shot="${shot//:/-}.jpg"
    ffmpeg -nostdin -v error -y -ss "$ts" -i "$V" -frames:v 1 -q:v 2 "$OUT/shots/$shot"
    echo "## $ts — $caption"
    echo
    echo "![$ts — $caption]($(basename "$OUT")/shots/$shot)"
    echo
  done < "$OUT/moments.txt"
  echo "---"
  echo
  echo '## Полный транскрипт'
  echo
  cat "$OUT/transcript.txt"
} > "${V%.*}_notes.md"

rm -f "$OUT/audio.wav"
echo "готово: ${V%.*}_notes.md ($(ls "$OUT/shots" | wc -l | tr -d ' ') кадров)"
