#!/usr/bin/env bash
# vidnotes — транскрипт видео + скриншоты ключевых мест (Claude выбирает моменты)
# usage: vidnotes video.mp4 [lang] [count|auto]
set -euo pipefail

V="${1:?usage: vidnotes <video> [lang=auto] [count=auto]}"
LANG_="${2:-auto}"
COUNT="${3:-auto}"
MODEL="${WHISPER_MODEL:-$HOME/.cache/whisper-cpp/ggml-large-v3-turbo-q5_0.bin}"
AGENT="${VIDNOTES_AGENT:-claude -p}"

[ -f "$V" ] || { echo "нет файла: $V" >&2; exit 1; }
[ -f "$MODEL" ] || { echo "нет модели: $MODEL" >&2; exit 1; }
ffprobe -v error -select_streams v:0 -show_entries stream=codec_type "$V" >/dev/null || { echo "не видео: $V" >&2; exit 1; }

# сколько моментов брать: пользователь этого заранее не знает, считаем от длительности —
# примерно один на две минуты, но не меньше 5 и не больше 30
if [ "$COUNT" = "auto" ]; then
  DUR=$(ffprobe -v error -show_entries format=duration -of csv=p=0 "$V" | cut -d. -f1)
  COUNT=$(( (DUR + 60) / 120 ))
  [ "$COUNT" -lt 5 ] && COUNT=5
  [ "$COUNT" -gt 30 ] && COUNT=30
  echo "      беру $COUNT моментов — по одному примерно на две минуты записи"
fi

OUT="${V%.*}_notes"
mkdir -p "$OUT/shots"

echo "[1/4] аудио…"
ffmpeg -nostdin -v error -y -i "$V" -vn -ar 16000 -ac 1 -c:a pcm_s16le "$OUT/audio.wav"

echo "[2/4] транскрипт…"
whisper-cli -m "$MODEL" -l "$LANG_" -f "$OUT/audio.wav" -osrt -otxt -of "$OUT/transcript" 2>"$OUT/whisper.log"
[ -s "$OUT/transcript.srt" ] || { echo "whisper не выдал транскрипт" >&2; exit 1; }

PROMPT="Below is an SRT transcript of a video. Pick the $COUNT most important moments — where something is decided, shown, demonstrated, or the topic shifts. Spread them across the whole video, not just the start.
Output ONLY lines in the exact format:
HH:MM:SS | short caption in the transcript's own language
No preamble, no numbering, no other text."

echo "[3/4] $AGENT выбирает моменты…"
if [ "$AGENT" = "claude -p" ]; then
  # родной путь: промпт аргументом, транскрипт на stdin, ответ с замером токенов
  claude -p --output-format json "$PROMPT" < "$OUT/transcript.srt" > "$OUT/agent.json" || true
  jq -r '.result // ""' "$OUT/agent.json" 2>/dev/null > "$OUT/agent.txt" || true
  jq -r '"      \(.usage.input_tokens + .usage.cache_creation_input_tokens + .usage.cache_read_input_tokens) токенов на вход (\(.usage.cache_read_input_tokens) из кэша), \(.usage.output_tokens) на выход, $\(.total_cost_usd)"' "$OUT/agent.json" 2>/dev/null || true
else
  # любой другой агент: всё одним куском на stdin, ответ текстом на stdout
  { printf '%s\n\n' "$PROMPT"; cat "$OUT/transcript.srt"; } | $AGENT > "$OUT/agent.txt" || true
fi
grep -oE '^[0-9]{2}:[0-9]{2}:[0-9]{2}([.,][0-9]{1,3})? \| .+' "$OUT/agent.txt" | head -n "$COUNT" > "$OUT/moments.txt" || true
[ -s "$OUT/moments.txt" ] || { echo "агент не вернул таймкоды — смотри $OUT/agent.txt и $OUT/transcript.srt" >&2; exit 1; }

echo "[4/4] скриншоты…"
{
  echo "# $(basename "$V")"
  echo
  i=0
  while IFS='|' read -r ts caption; do
    ts="${ts// /}"; ts="${ts//,/.}"; caption="${caption# }"
    i=$((i+1)); n=$(printf '%02d' "$i")
    shot="${n}_${ts%%.*}"; shot="${shot//:/-}.jpg"
    ffmpeg -nostdin -v error -y -ss "$ts" -i "$V" -frames:v 1 -q:v 2 "$OUT/shots/$shot"
    echo "## $ts — $caption"
    echo
    echo "![$ts — $caption]($(basename "$OUT")/shots/$shot)"
    echo
  done < "$OUT/moments.txt"
  echo "---"
  echo
  echo '## Полный транскрипт'
  echo
  cat "$OUT/transcript.txt"
} > "${V%.*}_notes.md"

rm -f "$OUT/audio.wav"
echo "готово: ${V%.*}_notes.md ($(ls "$OUT/shots" | wc -l | tr -d ' ') кадров)"
